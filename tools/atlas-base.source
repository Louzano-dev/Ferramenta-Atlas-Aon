const SIDEBAR_KEY = "atlas-seguros:sidebar";
function motionLimpar(st) {
  if (st.ctx) {
    try {
      st.ctx.kill();
    } catch (e) {/* ignora */}
    st.ctx = null;
  }
  clearTimeout(st.timer);
  st.touched.forEach(el => {
    if (el && el.style) {
      el.style.opacity = "";
      el.style.transform = "";
      el.style.removeProperty("--line");
    }
  });
  st.touched = [];
  st.restore.forEach(fn => {
    try {
      fn();
    } catch (e) {/* ignora */}
  });
  st.restore = [];
}
function motionPagina(root, st) {
  const g = gsapOk();
  motionLimpar(st);
  if (!g || !root || reduzMovimento()) return;
  const itens = [];
  Array.from(root.children).forEach(c => {
    if (c.classList.contains("grid") && c.children.length > 1) itens.push(...c.children);else itens.push(c);
  });
  const lista = itens.slice(0, 18);
  const barras = Array.from(root.querySelectorAll("[data-barra]")).map(b => b.children[1] && b.children[1].firstElementChild).filter(Boolean);
  const linhas = Array.from(root.querySelectorAll("tr[data-sinistro]")).slice(0, 14);
  const docs = Array.from(root.querySelectorAll("li[data-doc]")).slice(0, 14);
  const tl = root.querySelector(".atl-tl");
  const tlItens = tl ? Array.from(tl.children) : [];
  st.touched.push(...lista, ...barras, ...linhas, ...docs, ...tlItens);
  if (tl) st.touched.push(tl);
  st.ctx = g.context(() => {
    if (lista.length) g.fromTo(lista, {
      opacity: 0,
      y: 12
    }, {
      opacity: 1,
      y: 0,
      duration: .45,
      ease: "power2.out",
      stagger: .05,
      clearProps: "opacity,transform"
    });
    root.querySelectorAll("[data-stat]").forEach(card => {
      const num = card.children[1];
      const txt = num ? num.textContent.trim() : "";
      const no = num && num.firstChild;
      if (/^\d+$/.test(txt) && no && no.nodeType === 3) {
        const fim = Number(txt),
          o = {
            v: 0
          };
        no.nodeValue = "0";
        st.restore.push(() => {
          if (no.isConnected) no.nodeValue = String(fim);
        });
        g.to(o, {
          v: fim,
          duration: .9,
          delay: .15,
          ease: "power2.out",
          onUpdate: () => {
            no.nodeValue = String(Math.round(o.v));
          },
          onComplete: () => {
            no.nodeValue = String(fim);
          }
        });
      }
    });
    if (barras.length) g.fromTo(barras, {
      scaleX: 0,
      transformOrigin: "0% 50%"
    }, {
      scaleX: 1,
      duration: .7,
      delay: .25,
      ease: "power3.out",
      stagger: .03,
      clearProps: "transform"
    });
    if (linhas.length) g.fromTo(linhas, {
      opacity: 0,
      y: 6
    }, {
      opacity: 1,
      y: 0,
      duration: .3,
      delay: .1,
      stagger: .025,
      clearProps: "opacity,transform"
    });
    if (docs.length) g.fromTo(docs, {
      opacity: 0,
      y: 8
    }, {
      opacity: 1,
      y: 0,
      duration: .35,
      delay: .1,
      stagger: .04,
      clearProps: "opacity,transform"
    });
    if (tl) {
      g.fromTo(tlItens, {
        opacity: 0,
        x: -8
      }, {
        opacity: 1,
        x: 0,
        duration: .4,
        delay: .15,
        stagger: .06,
        ease: "power2.out",
        clearProps: "opacity,transform"
      });
      g.fromTo(tl, {
        "--line": 0
      }, {
        "--line": 1,
        duration: .9,
        delay: .15,
        ease: "power2.inOut",
        clearProps: "--line"
      });
    }
  }, root);
