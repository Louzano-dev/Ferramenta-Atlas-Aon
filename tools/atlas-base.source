/* ------------------------------ aplicação: estado único compartilhado pelos dois perfis ------------------------------ */
let ATOR = {
  perfil: "Aon",
  nome: "Vitor Louzano"
};
const perfilRotulo = () => ATOR.perfil === "Cliente" ? "Cliente" : "Aon";
function log(s, texto, interno = false) {
  return {
    ...s,
    atualizadoEm: nowTs(),
    historico: [...s.historico, {
      ts: nowTs(),
      texto,
      perfil: ATOR.perfil,
      por: ATOR.nome,
      interno
    }]
  };
}
const novoDoc = (nome, extra = {}) => ({
  id: uid("DOC"),
  nome,
  estado: "Recebido",
  solicitado: false,
  motivo: "",
  arquivos: [],
  manual: false,
  recebidoEm: nowTs(),
  validadoEm: null,
  ...extra
});
function AtlasApp() {
  const [sessao, setSessao] = useState(() => {
    const x = sessaoLoad();
    if (x) ATOR = {
      perfil: x.perfil === "cliente" ? "Cliente" : "Aon",
      nome: x.nome
    };
    return x;
  });
  const inicial = useRef(null);
  if (!inicial.current) inicial.current = storeLoad() || {
    sinistros: seedSinistros(),
    apolices: seedApolices()
  };
  const [sinistros, setSinistros] = useState(inicial.current.sinistros),
    [apolices, setApolices] = useState(inicial.current.apolices);
  const [storageOk, setStorageOk] = useState(true);
  const lastSaved = useRef(null),
    listaRef = useRef(sinistros);
  listaRef.current = sinistros;
  useEffect(() => {
    const str = storeStr(sinistros, apolices);
    if (str === lastSaved.current) return;
    lastSaved.current = str;
    setStorageOk(storeSaveRaw(str));
  }, [sinistros, apolices]);
  useEffect(() => {
    function onStorage(e) {
      // atualiza a tela quando outra aba do mesmo navegador altera os registros
      if (e.key !== STORE_KEY || e.newValue == null || e.newValue === lastSaved.current) return;
      const l = storeLoad();
      if (l) {
        lastSaved.current = e.newValue;
        setSinistros(l.sinistros);
        setApolices(l.apolices);
      }
    }
    window.addEventListener("storage", onStorage);
    return () => window.removeEventListener("storage", onStorage);
  }, []);

  // aplica uma alteração a um sinistro; ações da Aon "organizam" o caso; ao zerar as pendências, sai de "Aguardando informações"
  function patch(id, fn) {
    setSinistros(list => list.map(s0 => {
      if (s0.id !== id) return s0;
      let s = s0;
      if (ATOR.perfil === "Aon" && !s.organizadoEm) s = {
        ...log(s, "Caso em organização pela Aon"),
        organizadoEm: nowTs(),
        status: s.status === "Recebido" ? "Em organização" : s.status
      };
      const antes = pendencias(s).total;
      s = fn(s);
      if (antes > 0 && pendencias(s).total === 0 && s.status === "Aguardando informações do cliente") s = log({
        ...s,
        status: "Em organização"
      }, "Pendências atendidas; caso volta a ser organizado pela Aon");
      return s;
    }));
  }
  const dataIso = d => d || hojeIso();
  const actions = {
    addArquivos: (id, destino, metas) => patch(id, s => {
      if (!metas.length) return s;
      let docs = [...s.documentos],
        nomes = metas.map(m => m.nome).join(", "),
        alvoNome = "";
      const anexa = (d, ms) => ({
        ...d,
        arquivos: [...(d.estado === "Substituir" ? d.arquivos.map(a => ({
          ...a,
          substituido: true
        })) : d.arquivos), ...ms],
        estado: "Recebido",
        manual: false,
        recebidoEm: nowTs(),
        validadoEm: null
      });
      const nome = destino.startsWith("tipo:") ? destino.slice(5) : null;
      if (nome === "Outro documento") {
        metas.forEach(m => docs.push(novoDoc(m.nome, {
          arquivos: [m]
        })));
        alvoNome = "Outro documento";
      } else {
        const i = nome ? docs.findIndex(d => d.nome === nome) : docs.findIndex(d => d.id === destino.slice(4));
        if (i >= 0) {
          docs[i] = anexa(docs[i], metas);
          alvoNome = docs[i].nome;
        } else {
          docs.push(novoDoc(nome || "Documento", {
            arquivos: metas
          }));
          alvoNome = nome || "Documento";
        }
      }
      return log({
        ...s,
        documentos: docs
      }, `${ATOR.nome} (${perfilRotulo()}) anexou ${metas.length} arquivo(s) em "${alvoNome}": ${nomes}`);
    }),
    removerArquivo: (id, docId, arqId) => {
      arquivoDel(arqId);
      patch(id, s => {
        const d = s.documentos.find(x => x.id === docId);
        if (!d) return s;
        const arq = d.arquivos.find(a => a.id === arqId),
          restantes = d.arquivos.filter(a => a.id !== arqId);
        let docs;
        if (restantes.filter(a => !a.substituido).length === 0 && !d.manual) docs = d.solicitado ? s.documentos.map(x => x.id === docId ? {
          ...x,
          arquivos: restantes,
          estado: "Pendente",
          validadoEm: null
        } : x) : s.documentos.filter(x => x.id !== docId);else docs = s.documentos.map(x => x.id === docId ? {
          ...x,
          arquivos: restantes
        } : x);
        return log({
          ...s,
          documentos: docs
        }, `Arquivo removido de "${d.nome}": ${arq ? arq.nome : ""}`, ATOR.perfil === "Aon");
      });
    },
    marcarDocRecebido: (id, docId) => patch(id, s => log({
      ...s,
      documentos: s.documentos.map(d => d.id === docId ? {
        ...d,
        estado: "Recebido",
        manual: true,
        recebidoEm: nowTs()
      } : d)
    }, `Documento marcado como recebido por outro canal: ${s.documentos.find(d => d.id === docId).nome}`)),
    validarDoc: (id, docId) => patch(id, s => log({
      ...s,
      documentos: s.documentos.map(d => d.id === docId ? {
        ...d,
        estado: "Validado",
        validadoEm: nowTs()
      } : d)
    }, `Documento validado pela Aon: ${s.documentos.find(d => d.id === docId).nome}`)),
