<script>
window.addEventListener('error',function(e){ if(!document.getElementById('root').children.length){ var f=document.getElementById('falha'); if(f) f.style.display='block'; } });
</script>
<script>
const {
  useState,
  useMemo,
  useEffect,
  useRef
} = React;

/* ---------------------------------------------------------------------------------
   Atlas Seguros — protótipo de demonstração (TCC · programa Jovem Seguro · Aon)

   Dois perfis: Cliente (empresa segurada) e Aon (corretora). Os dois trabalham sobre os MESMOS registros de
   sinistro, guardados no localStorage deste navegador. Não há servidor, login real nem sincronização entre
   dispositivos. A seguradora NÃO tem perfil: suas etapas (recebimento, abertura formal, protocolo, cobertura e
   indenização) são informações comunicadas à Aon e REGISTRADAS por ela. O Atlas não decide nada disso.
--------------------------------------------------------------------------------- */

function makeIcon(paths) {
  return function Icon({
    size = 16,
    className = "",
    strokeWidth = 2,
    ...rest
  }) {
    return React.createElement("svg", {
      width: size,
      height: size,
      viewBox: "0 0 24 24",
      fill: "none",
      stroke: "currentColor",
      strokeWidth,
      strokeLinecap: "round",
      strokeLinejoin: "round",
      className,
      ...rest
    }, paths.map((p, i) => React.createElement(p.tag, {
      key: i,
      ...p.attrs
    })));
  };
}
const CheckCircle2 = makeIcon([{
  tag: "circle",
  attrs: {
    cx: 12,
    cy: 12,
    r: 10
  }
}, {
  tag: "path",
  attrs: {
    d: "M9 12l2 2 4-4"
  }
}]);
const Circle = makeIcon([{
  tag: "circle",
  attrs: {
    cx: 12,
    cy: 12,
    r: 9
  }
}]);

/* ---------------------------------- utils ---------------------------------- */
const pad2 = n => String(n).padStart(2, "0");
const isoFromDate = d => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
const TODAY_ISO = isoFromDate(new Date());
const isoDaysAgo = n => {
  const d = new Date();
  d.setDate(d.getDate() - n);
  return isoFromDate(d);
};
const nowTs = () => new Date().toISOString();
const formatDate = iso => {
  if (!iso) return "—";
  const [y, m, d] = String(iso).slice(0, 10).split("-");
  return `${d}/${m}/${y}`;
};
const fmtTs = ts => {
  if (!ts) return "—";
  if (String(ts).length <= 10) return formatDate(ts);
  const d = new Date(ts);
  return `${d.toLocaleDateString("pt-BR")} ${d.toLocaleTimeString("pt-BR", {
    hour: "2-digit",
    minute: "2-digit"
  })}`;
};
const fmtBRL = n => (Number(n) || 0).toLocaleString("pt-BR", {
  style: "currency",
  currency: "BRL",
  maximumFractionDigits: 2
});
const fmtTam = b => b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : b >= 1024 ? `${Math.round(b / 1024)} KB` : `${b || 0} B`;
const daysSinceTs = ts => ts ? Math.max(0, Math.floor((Date.now() - new Date(ts).getTime()) / 86400000)) : 0;
const uid = p => `${p}-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`;
const norm = x => String(x || "").trim().toLowerCase();

/* ----------------------------- vocabulário do domínio ----------------------------- */
const TIPOS_INCIDENTE = ["Ransomware", "Vazamento de dados", "Acesso não autorizado", "Comprometimento de credenciais", "Fraude digital", "Indisponibilidade de sistema", "Outro"];
const SEGURADOS_DEMO = ["Varejo Horizonte S.A.", "Financeira Alvorada", "Grupo Vida Plena Saúde", "Transportes Trilha Rápida", "Nimbus Tecnologia"];
const EQUIPE_AON = ["Vitor Louzano", "Marina Souza", "Diego Farias", "Ana Prado", "Bianca Reis"];
const CANAIS_RECEBIMENTO = ["Telefone", "E-mail", "Reunião", "Mensagem", "Outro"];
const CANAIS_ENCAMINHAMENTO = ["E-mail", "Portal da seguradora", "Telefone", "Outro canal"];
const SEGURADORA_DEMO = "Seguradora Atlas Demo S.A. (fictícia)";
const FONTES_INFO = ["Informado pela seguradora (e-mail)", "Informado pela seguradora (telefone)", "Documento ou carta da seguradora", "Portal da seguradora", "Outra fonte"];
const DOCS_SUGERIDOS = ["Evidência do ataque (capturas, nota de resgate)", "Logs de segurança", "Relatório técnico (forense)", "Cópia da apólice", "Comprovantes de custos e prejuízos", "Outro documento"];
const ORIGEM_ROTULO = {
  portal: "Portal do cliente",
  manual: "Registro manual (Aon)",
  demo: "Caso de demonstração"
};
const ORIGEM_TONE = {
  portal: "blue",
  manual: "gray",
  demo: "amber"
};
const ETAPAS = ["Registro", "Triagem", "Evidências", "Análise", "Tratamento", "Retorno", "Encerramento"];
const PRIORIDADES = ["Baixa", "Média", "Alta", "Crítica"];
const ESTADOS_CICLO = ["Recebido", "Em análise", "Aguardando informações", "Aguardando documentação", "Em avaliação de cobertura", "Em tratamento", "Resolvido"];
const COBERTURAS_ITENS = ["Resposta a incidentes", "Interrupção de negócios", "Restauração de dados", "Extorsão cibernética", "Responsabilidade por privacidade", "Notificação a titulares e autoridades", "Gerenciamento de crise", "Fraude e perdas financeiras"];
const ENC_ORDEM = ["nenhum", "preparado", "enviado", "recebido", "aberto"];
const ANDAMENTOS_SEG = ["Em análise pela seguradora", "Aguardando documentos adicionais"];
const COB_SITUACOES = ["Cobertura aceita", "Cobertura parcial", "Cobertura recusada"];
const INDEN_STATUS = ["Aguardando definição de valores", "Aguardando pagamento", "Pagamento parcial", "Indenização paga", "Não aplicável"];
const STATUS_AON = ["Em organização", "Aguardando informações do cliente"];
const MAX_ARQUIVO_MB = 20;
const STORE_KEY = "atlas-seguros:v5";
const STORE_KEY_V4 = "atlas-seguros:v4";
const SESSAO_KEY = "atlas-seguros:sessao";

/* ------------------------------ dados fictícios de demonstração ------------------------------ */
const T = (d, h = 10) => `${isoDaysAgo(d)}T${pad2(h)}:00:00`;
const H = (d, texto, perfil, por, interno = false, h = 10) => ({
  ts: T(d, h),
  texto,
  perfil,
  por,
  interno
});
function caso(o) {
  const hist = o.historico;
  return {
    id: o.id,
    segurado: o.segurado,
    apolice: o.apolice || "",
    tipo: o.tipo,
    dataOcorrencia: isoDaysAgo(o.evDias),
    dataComunicacao: isoDaysAgo(o.comDias),
    descricao: o.descricao,
    sistemas: o.sistemas || "",
    impactos: o.impactos || "",
    exposicaoDados: !!o.exposicaoDados,
    indisponibilidade: !!o.indisponibilidade,
    pessoasAfetadas: o.pessoas === undefined ? null : o.pessoas,
    valorEstimado: o.valor === undefined ? null : o.valor,
    medidas: o.medidas || "",
    dataIdentificacao: "",
    naoSei: o.naoSei || {},
    triagem: o.triagem || null,
    tarefas: o.tarefas || [],
    contato: o.contato,
    origem: "demo",
    canal: o.canal || "Portal do cliente",
    registradoPor: o.registradoPor,
    criadoEm: T(o.comDias, 9),
    responsavel: o.responsavel,
    status: o.status,
    organizadoEm: o.organizado === false ? null : T(o.comDias - 1 < 0 ? 0 : o.comDias - 1, 11),
    documentos: o.documentos || [],
    solicitacoes: o.solicitacoes || [],
    complementos: [],
    encaminhamento: o.enc || {
      estado: "nenhum"
    },
    andamentoSeg: o.andamentoSeg || "",
    andamentoEm: o.andamentoEm || null,
    mensagens: [],
    retornos: [],
    retornoPrevisto: "",
    cobertura: o.cobertura || null,
    indenizacao: o.indenizacao || null,
    encerrado: o.encerrado || null,
    historico: hist,
    atualizadoEm: hist[hist.length - 1].ts
  };
}
