e:hover{text-decoration-line:underline}.disabled\:cursor-not-allowed:disabled{cursor:not-allowed}.disabled\:opacity-50:disabled{opacity:.5}@media (min-width:640px){.sm\:col-span-2{grid-column:span 2/span 2}.sm\:block{display:block}.sm\:\!w-64{width:16rem!important}.sm\:\!w-80{width:20rem!important}.sm\:\!w-auto{width:auto!important}.sm\:grid-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}.sm\:grid-cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}.sm\:grid-cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}.sm\:px-6{padding-left:1.5rem;padding-right:1.5rem}}@media (min-width:768px){.md\:block{display:block}.md\:hidden{display:none}.md\:grid-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (min-width:1024px){.lg\:grid-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}.lg\:grid-cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}.lg\:grid-cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}}</style>
<style id="atlas-redesign">
/* ============================================================
   ATLAS SEGUROS · camada visual (apenas visual), identidade Aon
   Cores: Visual Identity Basics + Aon Brand Snapshot 2026
   ============================================================ */
:root{
  --red:#EB0017;
  --navy:#262836; --g1:#46535E; --g2:#5D6D78; --g3:#82939A; --g4:#ACC0C4; --g5:#CDDBDE; --g6:#E5EFF0; --g7:#EEF6F7; --g8:#F9FCFC;
  --teal-l:#29B0C3; --teal-d:#007585; --or-l:#F25D00; --or-d:#D14900;
  --chart-1:#0055A8; --chart-2:#0084BB;
  --ink:var(--navy); --ink-2:var(--g1); --muted:var(--g2);
  --bg:var(--g8); --surface:#fff; --line:var(--g5); --line-2:var(--g6);
  --r:6px; --r-sm:4px;
  --side-w:264px; --side-w-c:76px;
  --font:"Helvetica Now Text","Helvetica Now","Helvetica Neue",Helvetica,Arial,"Liberation Sans",sans-serif;
  --font-d:"Helvetica Now Display","Helvetica Now","Helvetica Neue",Helvetica,Arial,"Liberation Sans",sans-serif;
}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--bg);color:var(--g2);font-size:14.5px;line-height:1.4}
::selection{background:var(--g5);color:var(--navy)}
*{scrollbar-width:thin;scrollbar-color:var(--g4) transparent}

/* tipografia: Navy 01 em títulos, Gray 02 em corpo ------------- */
h1,h2,h3{font-family:var(--font-d);color:var(--navy);letter-spacing:-.012em;line-height:1.2}
h1.text-xl{font-size:1.5rem;line-height:1.9rem;font-weight:600}
h1.text-2xl{font-size:2rem;line-height:2.3rem;font-weight:500;letter-spacing:-.02em}
.text-xs{font-size:12.5px;line-height:1.45}
.text-\[11px\]{font-size:12px}
.text-sm{font-size:14px;line-height:1.5}
.text-gray-300{color:var(--g3)}
.text-gray-400{color:var(--g2)}
.text-gray-500{color:var(--g2)}
.text-gray-600,.text-gray-700{color:var(--g1)}
.text-gray-800,.text-gray-900{color:var(--navy)}
.font-semibold{font-weight:600}

/* mapeamento da paleta anterior para a paleta Aon ------------- */
.bg-blue-700,.bg-blue-600{background-color:var(--navy)}
.hover\:bg-blue-800:hover{background-color:var(--navy)}
.text-blue-700,.text-blue-800,.hover\:text-blue-800:hover{color:var(--navy)}
.text-blue-600{color:var(--navy)}
.border-blue-700,.border-blue-600,.hover\:border-blue-400:hover{border-color:var(--navy)}
.ring-blue-600{--tw-ring-color:var(--navy)}
.bg-blue-50{background-color:var(--g7)}
.border-blue-200{border-color:var(--g5)}
.bg-gray-50{background-color:var(--g8)}
.bg-gray-100{background-color:var(--g6)}
.hover\:bg-gray-50:hover{background-color:var(--g7)}
.border-gray-200,.border-gray-300{border-color:var(--g5)}
.border-gray-100{border-color:var(--g6)}
.divide-gray-100>:not([hidden])~:not([hidden]){border-color:var(--g6)}
/* estados semânticos: texto navy, cor só na borda e no marcador */
.bg-red-50,.bg-amber-50,.bg-emerald-50,.bg-orange-50{background-color:var(--g8)}
.border-red-200{border-color:var(--red)}
.border-amber-200{border-color:var(--or-l)}
.border-emerald-200,.border-emerald-600{border-color:var(--teal-d)}
.border-orange-200{border-color:var(--or-d)}
.text-red-600,.text-red-700{color:var(--red)}
.text-amber-500,.text-amber-600,.text-orange-700{color:var(--or-d)}
.text-amber-700,.text-amber-800,.text-emerald-700,.text-emerald-800{color:var(--navy)}
.text-emerald-600{color:var(--teal-d)}
.bg-emerald-600{background-color:var(--teal-d)}

/* cartões ------------------------------------------------------ */
.atl-card{background:var(--surface);border:1px solid var(--g5);border-radius:var(--r);box-shadow:none;transition:border-color .2s ease}
.atl-card.p-5{padding:1.35rem}
button.atl-card:hover,a.atl-card:hover,[data-stat]:hover,.atl-choice:hover{border-color:var(--navy)!important}
.atl-card[data-relatorio],.atl-card[data-guia-rapido]{border-color:var(--g4);background:var(--g8)}

/* botões ------------------------------------------------------- */
.atl-btn{min-height:40px;border-radius:var(--r-sm);font-weight:500;font-size:14px;transition:background-color .18s,border-color .18s,color .18s;will-change:transform}
.atl-btn-primary{background:var(--red);color:#fff;border:1px solid var(--red)}
.atl-btn-primary:hover:not(:disabled){background:var(--navy);border-color:var(--navy)}
.atl-btn-secondary{background:#fff;border:1px solid var(--g4);color:var(--navy)}
.atl-btn-secondary:hover:not(:disabled){background:var(--g7);border-color:var(--g3)}
.atl-link{border-radius:2px;color:var(--navy);text-decoration:underline;text-decoration-color:var(--g4);text-underline-offset:3px;transition:text-decoration-color .15s}
.atl-link:hover{text-decoration-color:var(--red)}
button:focus-visible,summary:focus-visible,a:focus-visible,[role=checkbox]:focus-visible,select:focus-visible,input[type=file]:focus-visible{outline:2px solid var(--navy);outline-offset:2px;border-radius:3px}

/* campos ------------------------------------------------------- */
.input{border:1px solid var(--g4);border-radius:var(--r-sm);padding:9px 12px;font-size:14.5px;background:#fff;color:var(--navy);min-height:40px;transition:border-color .15s,box-shadow .15s}
textarea.input{min-height:0}
.input:hover:not(:disabled){border-color:var(--g3)}
.input:focus{border-color:var(--navy);box-shadow:0 0 0 2px var(--g5)}
.input:disabled{background:var(--g7);color:var(--g2)}
::placeholder{color:var(--g3)!important}
label.block>.text-xs.text-gray-500{font-weight:600;color:var(--g1);font-size:12.5px}
input[type=file]{font-size:13.5px;color:var(--g2)}
input[type=file]::file-selector-button{margin-right:12px;padding:8px 14px;border:1px solid var(--g4);border-radius:var(--r-sm);background:#fff;color:var(--navy);font:500 13.5px var(--font);cursor:pointer;transition:background .15s}
input[type=file]::file-selector-button:hover{background:var(--g7)}

/* área de upload ----------------------------------------------- */
.atl-drop{position:relative;border:1px dashed var(--g3);background:var(--g8);border-radius:var(--r);padding:14px 16px;transition:border-color .2s,background .2s;overflow:hidden}
.atl-drop:hover,.atl-drop:focus-within{border-color:var(--navy);background:var(--g7)}
.atl-drop.is-busy::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;
  background:linear-gradient(90deg,transparent,var(--red),transparent);background-size:40% 100%;background-repeat:no-repeat;animation:atl-busy 1s linear 6}
@keyframes atl-busy{from{background-position:-40% 0}to{background-position:140% 0}}

/* badges: texto navy, a cor fica no marcador (não depende só da cor) */
.atl-badge{border-radius:var(--r-sm);padding:2px 9px 2px 8px;font-size:12px;font-weight:500;gap:7px;line-height:1.5;white-space:nowrap;background:#fff;color:var(--navy);border:1px solid var(--g5)}
.atl-badge .atl-dot{width:7px;height:7px;border-radius:50%;background:var(--g3);flex:none}
.atl-badge[data-tone=red] .atl-dot{background:var(--red)}
.atl-badge[data-tone=amber] .atl-dot{background:var(--or-l)}
.atl-badge[data-tone=orange] .atl-dot{background:var(--or-d)}
.atl-badge[data-tone=green] .atl-dot{background:var(--teal-d)}
.atl-badge[data-tone=blue] .atl-dot{background:var(--teal-l)}
.atl-badge[data-tone=gray] .atl-dot{background:var(--g3)}

/* mensagens ----------------------------------------------------- */
.atl-msg{border-radius:var(--r-sm);padding:12px 16px;color:var(--navy)}
.atl-msg.text-red-700,.atl-msg.text-red-600{color:var(--navy)}

/* tabelas: cabeçalho Gray 06 em negrito, faixas Gray 08, linhas brancas */
.atl-card table{border-collapse:separate;border-spacing:0}
.atl-card thead tr,thead tr{background:var(--g6)}
.atl-card th{font-size:12.5px;font-weight:700;color:var(--navy);padding:11px 14px!important;border-bottom:3px solid #fff;text-align:left}
.atl-card tbody td{padding:12px 14px!important;color:var(--navy);border-bottom:1px solid #fff;vertical-align:top}
.atl-card tbody tr:nth-child(even){background:var(--g8)}
.atl-card tbody tr:nth-child(odd){background:#fff}
.atl-card tbody tr{transition:background-color .15s}
.atl-card tbody tr:hover{background:var(--g7)}
.atl-card tbody tr:last-child td{border-bottom:0}
.atl-card .divide-y>:not([hidden])~:not([hidden]){border-color:var(--g6)}

/* indicadores --------------------------------------------------- */
[data-stat]{padding:1.1rem 1.25rem;position:relative;overflow:hidden}
[data-stat]>div:first-child{font-size:13px;font-weight:500;color:var(--g2)}
[data-stat]>div:nth-child(2){font-family:var(--font-d);font-size:clamp(1.5rem,1.2rem + .9vw,1.95rem);line-height:2.3rem;font-weight:500;letter-spacing:-.02em;color:var(--navy);margin-top:.3rem;white-space:nowrap}
[data-stat]>div:nth-child(3){font-size:12.5px;color:var(--g2);margin-top:.15rem}
@media (min-width:1024px){.grid.lg\:grid-cols-4:has(>[data-stat]:nth-child(6)){grid-template-columns:repeat(3,minmax(0,1fr))}}

/* gráficos: grade discreta, cor informativa só nas séries -------- */
[data-barra]>div:nth-child(2){background:var(--g6);border-radius:2px;height:10px}
[data-barra]>div:nth-child(2)>div{border-radius:2px;height:10px;background:var(--chart-1)}
[data-barra] .text-gray-600{font-size:13px;color:var(--g1)}

/* linha do tempo ------------------------------------------------ */
.atl-tl{position:relative;--line:1}
.atl-tl-item{position:relative;display:flex;gap:14px;padding-bottom:18px}
.atl-tl-item:last-child{padding-bottom:0}
.atl-tl-item::before{content:"";position:absolute;left:11px;top:26px;bottom:-2px;width:2px;background:var(--g5)}
.atl-tl-item:last-child::before{display:none}
.atl-tl-item[data-estado=feito]::before{background:var(--navy);transform-origin:top;transform:scaleY(var(--line,1))}
.atl-tl-dot{position:relative;z-index:1;flex:none;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid var(--g4);background:#fff;color:var(--g3)}
.atl-tl-item[data-estado=feito] .atl-tl-dot{background:var(--navy);border-color:var(--navy);color:#fff}
.atl-tl-item[data-estado=atual] .atl-tl-dot{border-color:var(--red);color:var(--red);box-shadow:0 0 0 4px var(--g6)}
.atl-tl-body{min-width:0;padding-top:1px}
.atl-tl-title{font-size:14.5px;color:var(--navy)}
.atl-tl-item[data-estado=atual] .atl-tl-title{font-weight:700}
.atl-tl-item[data-estado=pendente] .atl-tl-title{color:var(--g2);font-weight:400}

/* listas e documentos -------------------------------------------- */
li[data-doc]{padding:12px 0}
details.atl-card>summary{list-style:none;display:flex;align-items:center;justify-content:space-between}
details.atl-card>summary::-webkit-details-marker{display:none}
details.atl-card>summary::after{content:"+";font-size:18px;color:var(--g2)}
details.atl-card[open]>summary::after{content:"\2013"}

/* landing --------------------------------------------------------- */
.atl-landing{background:var(--g8)}
.atl-landing header{background:#fff;border-color:var(--g5)}
.atl-landing header>div:first-child{background:none!important;color:var(--navy)!important;width:auto;font-size:20px;font-weight:700;padding-right:2px}
.atl-landing h1.text-2xl{font-size:2.35rem;line-height:2.7rem;max-width:44rem}
.atl-choice{cursor:pointer;position:relative;padding:1.6rem!important}
.atl-choice .text-base{font-size:1.1rem;color:var(--navy)}

/* legal (Termos e Privacidade) ------------------------------------ */
.atl-legal{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center;margin-top:10px;font-size:12.5px}
.atl-legal button{color:var(--navy);text-decoration:underline;text-decoration-color:var(--g4);text-underline-offset:3px;min-height:24px}
.atl-legal button:hover{text-decoration-color:var(--red)}
.atl-legal-n{flex-basis:100%;border:1px solid var(--g5);background:var(--g8);border-radius:var(--r-sm);padding:10px 14px;color:var(--navy)}

/* ===================== shell: menu lateral + topo ===================== */
.atl-shell{display:flex;min-height:100vh;background:var(--bg)}
.atl-side{position:sticky;top:0;align-self:flex-start;height:100vh;width:var(--side-w);flex:none;z-index:40;background:#fff;color:var(--g1);display:flex;flex-direction:column;padding:14px 12px;border-right:1px solid var(--g5)}
.atl-side[data-collapsed=true]{width:var(--side-w-c)}
.atl-brand{display:flex;align-items:center;gap:10px;padding:6px 8px 18px;min-height:56px}
.atl-logo{width:auto;height:auto;border-radius:0;flex:none;display:flex;align-items:center;justify-content:center;color:var(--navy);font-family:var(--font-d);font-weight:700;font-size:24px;line-height:1;background:none}
.atl-brand-t{line-height:1.2;min-width:0}
.atl-brand-t strong{display:block;color:var(--navy);font-family:var(--font-d);font-size:16px;font-weight:600}
.atl-brand-t span{display:block;font-size:12px;color:var(--g2);margin-top:2px;white-space:nowrap}
.atl-nav{flex:1;overflow-y:auto;overflow-x:visible;padding:2px 0}
.atl-group{margin-bottom:14px}
.atl-group+.atl-group{padding-top:14px;border-top:1px solid var(--g6)}
.atl-group-t{font-size:12px;font-weight:700;color:var(--g2);padding:0 10px 8px}
.atl-nav-item{position:relative;width:100%;display:flex;align-items:center;gap:12px;padding:9px 10px;border-radius:var(--r-sm);color:var(--g1);font-size:14.5px;font-weight:500;text-align:left;transition:background-color .18s,color .18s;min-height:40px}
.atl-nav-item svg{flex:none;color:var(--g2);transition:color .18s}
.atl-nav-item:hover{background:var(--g7);color:var(--navy)}
.atl-nav-item:hover svg{color:var(--navy)}
.atl-nav-item[aria-current=page]{background:var(--g6);color:var(--navy);font-weight:700}
.atl-nav-item[aria-current=page]::before{content:"";position:absolute;left:-12px;top:8px;bottom:8px;width:3px;background:var(--red)}
.atl-nav-item[aria-current=page] svg{color:var(--navy)}
.atl-side-foot{border-top:1px solid var(--g6);padding-top:12px;display:flex;flex-direction:column;gap:8px}
.atl-user{display:flex;align-items:center;gap:11px;padding:8px;border-radius:var(--r-sm);background:var(--g8);border:1px solid var(--g6)}
.atl-avatar{width:34px;height:34px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;background:var(--navy)}
.atl-user-t{min-width:0;line-height:1.3}
.atl-user-t strong{display:block;color:var(--navy);font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.atl-user-t span{display:block;color:var(--g2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.atl-foot-btn{display:flex;align-items:center;gap:12px;width:100%;padding:9px 10px;border-radius:var(--r-sm);color:var(--g1);font-size:14px;font-weight:500;min-height:40px;transition:background .18s,color .18s;position:relative}
.atl-foot-btn:hover{background:var(--g7);color:var(--navy)}

@media (min-width:901px){
  .atl-side[data-collapsed=true] .atl-nav-label,.atl-side[data-collapsed=true] .atl-brand-t,.atl-side[data-collapsed=true] .atl-user-t,.atl-side[data-collapsed=true] .atl-group-t{display:none}
  .atl-side[data-collapsed=true] .atl-brand{justify-content:center;padding-left:0;padding-right:0}
  .atl-side[data-collapsed=true] .atl-nav-item,.atl-side[data-collapsed=true] .atl-foot-btn{justify-content:center;padding-left:0;padding-right:0}
  .atl-side[data-collapsed=true] .atl-user{justify-content:center;padding:8px 0;background:transparent;border-color:transparent}
  .atl-side[data-collapsed=true] .atl-group+.atl-group{padding-top:10px}
  .atl-side[data-collapsed=true] [data-tip]:hover::after{content:attr(data-tip);position:absolute;left:calc(100% + 14px);top:50%;transform:translateY(-50%);white-space:nowrap;background:var(--navy);color:#fff;font-size:12.5px;font-weight:500;padding:6px 10px;border-radius:var(--r-sm);z-index:60;pointer-events:none}
}

.atl-main{flex:1;min-width:0;display:flex;flex-direction:column}
.atl-top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:12px;min-height:60px;padding:0 28px;background:#fff;border-bottom:1px solid var(--g5)}
.atl-crumb{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--g2);min-width:0}
.atl-crumb strong{color:var(--navy);font-weight:700;white-space:nowrap}
.atl-top-r{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:13px;color:var(--g2);min-width:0}
.atl-top-r .atl-emp{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:18rem}
.atl-menu-btn{display:none;width:40px;height:40px;border-radius:var(--r-sm);align-items:center;justify-content:center;border:1px solid var(--g4);background:#fff;color:var(--navy)}
.atl-content{flex:1;width:100%;max-width:1320px;margin:0 auto;padding:28px 28px 20px}
.atl-page>*+*{margin-top:1.25rem}
.atl-foot{padding:16px 28px;border-top:1px solid var(--g5);background:#fff}
.atl-overlay{display:none}

@media (max-width:900px){
  .atl-side{position:fixed;left:0;top:0;bottom:0;height:100%;width:var(--side-w)!important;transform:translateX(-102%);transition:transform .3s cubic-bezier(.22,.8,.3,1)}
  .atl-side.is-open{transform:translateX(0)}
  .atl-overlay{display:block;position:fixed;inset:0;z-index:35;background:rgba(38,40,54,.5);opacity:0;pointer-events:none;transition:opacity .25s}
  .atl-overlay.is-open{opacity:1;pointer-events:auto}
  .atl-menu-btn{display:inline-flex}
  .atl-top{padding:0 16px}
  .atl-content{padding:20px 16px 16px}
  .atl-foot{padding:14px 16px}
  .atl-top-r .atl-emp{display:none}
  .atl-collapse-btn{display:none!important}
}
@media (max-width:640px){
  h1.text-xl{font-size:1.3rem}
  .atl-landing h1.text-2xl{font-size:1.75rem;line-height:2.1rem}
  .atl-card.p-5{padding:1.1rem}
  [data-stat]>div:nth-child(2){font-size:1.6rem}
  .atl-btn{min-height:44px}
  .input{min-height:44px}
  .atl-legal button{min-height:32px}
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
}
@media print{.atl-side,.atl-top,.atl-overlay{display:none}}

</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.14.2/gsap.min.js" onerror="void 0"></script>
</head>
<body>
<div id="root"></div>
<noscript><p style="font-family:sans-serif;padding:24px">O Atlas Seguros precisa de JavaScript ativado no navegador para funcionar.</p></noscript>
<div id="falha" style="display:none;font-family:sans-serif;padding:24px;max-width:560px">Não foi possível iniciar o Atlas neste navegador. Abra o arquivo diretamente em um navegador atualizado (Chrome, Safari, Edge ou Firefox), e não na prévia de um aplicativo de mensagens ou de nuvem.</div>
