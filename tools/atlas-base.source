/* ------------------------------ lógica de domínio (derivada dos registros) ------------------------------ */
const encIdx = s => ENC_ORDEM.indexOf(s.encaminhamento && s.encaminhamento.estado || "nenhum");
const visivel = (x, paraCliente) => !!x && (!paraCliente || x.compartilhar !== false);
const coberturaAceita = s => !!(s.cobertura && (s.cobertura.situacao === "Cobertura aceita" || s.cobertura.situacao === "Cobertura parcial"));
function indenStatus(s) {
  if (s.indenizacao && s.indenizacao.status) return s.indenizacao.status;
  if (s.cobertura && s.cobertura.situacao === "Cobertura recusada") return "Não aplicável";
  return s.cobertura ? "Aguardando definição de valores" : "Aguardando atualização";
}
function pendencias(s) {
  const docs = s.documentos.filter(d => d.estado === "Pendente" || d.estado === "Substituir");
  const sols = (s.solicitacoes || []).filter(x => x.status === "Aberta");
  return {
    docs,
    sols,
    total: docs.length + sols.length
  };
}
/* Status único do caso, derivado dos fatos registrados. Nunca avança sozinho para etapas da seguradora. */
function statusCaso(s, paraCliente) {
  const p = pendencias(s),
    enc = encIdx(s);
  if (s.encerrado) return {
    label: "Acompanhamento concluído",
    tone: "green"
  };
  const ind = visivel(s.indenizacao, paraCliente) ? s.indenizacao.status : null;
  if (ind === "Indenização paga") return {
    label: "Indenização paga",
    tone: "green"
  };
  if (ind === "Pagamento parcial") return {
    label: "Indenização parcialmente paga",
    tone: "green"
  };
  if (ind === "Aguardando pagamento") return {
    label: "Indenização em andamento",
    tone: "blue"
  };
  if (visivel(s.cobertura, paraCliente)) {
    const c = s.cobertura.situacao;
    return {
      label: c === "Cobertura recusada" ? "Cobertura não aceita pela seguradora" : `${c} pela seguradora`,
      tone: c === "Cobertura recusada" ? "red" : "green"
    };
  }
  if (enc >= 4) {
    if (p.total > 0 || s.andamentoSeg === "Aguardando documentos adicionais") return {
      label: "Aguardando documentos adicionais",
      tone: "amber"
    };
    if (s.andamentoSeg === "Em análise pela seguradora") return {
      label: "Em análise pela seguradora",
      tone: "green"
    };
    return {
      label: "Sinistro formalmente aberto pela seguradora",
      tone: "green"
    };
  }
  if (enc === 3) return {
    label: "Recebimento confirmado pela seguradora",
    tone: "blue"
  };
  if (enc === 2) return {
    label: "Encaminhada à seguradora",
    tone: "blue"
  };
  if (p.total > 0 || s.status === "Aguardando informações do cliente") return {
    label: "Aguardando informações do cliente",
    tone: "amber"
  };
  return s.organizadoEm ? {
    label: "Em organização pela Aon",
    tone: "blue"
  } : {
    label: "Comunicação registrada",
    tone: "gray"
  };
}
/* Linha do tempo do cliente: só marca como concluído o que foi registrado. */
function linhaDoTempo(s, paraCliente) {
  const enc = s.encaminhamento || {},
    idx = encIdx(s),
    p = pendencias(s);
  const cob = visivel(s.cobertura, paraCliente) ? s.cobertura : null,
    ind = visivel(s.indenizacao, paraCliente) ? s.indenizacao : null;
  const teveSol = (s.solicitacoes || []).length > 0 || s.documentos.some(d => d.solicitado);
  const steps = [{
    k: "reg",
    titulo: "Comunicação registrada no Atlas",
    fonte: "Registro no Atlas",
    feito: true,
    quando: s.criadoEm
  }, {
    k: "org",
    titulo: "Caso em organização pela Aon",
    fonte: "Registrado pela Aon",
    feito: !!s.organizadoEm,
    quando: s.organizadoEm
  }, {
    k: "env",
    titulo: "Comunicação encaminhada à seguradora",
    fonte: "Encaminhamento registrado pela Aon",
    feito: idx >= 2,
    quando: enc.dataEnvio
  }, {
    k: "rec",
    titulo: "Recebimento confirmado pela seguradora",
    fonte: "Informado pela seguradora, registrado pela Aon",
    feito: idx >= 3,
    quando: enc.dataRecebimento
  }, {
    k: "abr",
    titulo: "Sinistro formalmente aberto pela seguradora",
    fonte: "Informado pela seguradora, registrado pela Aon",
    feito: idx >= 4,
    quando: enc.dataAbertura,
    detalhe: idx >= 4 ? enc.protocolo ? `Protocolo da seguradora: ${enc.protocolo}` : "Protocolo ainda não registrado (aguardando atualização)" : null
  }, {
    k: "ana",
    titulo: "Em análise pela seguradora",
    fonte: "Informado pela seguradora, registrado pela Aon",
    feito: idx >= 4 && !!s.andamentoSeg,
    quando: s.andamentoEm,
    detalhe: s.retornoPrevisto ? `Retorno previsto informado pela seguradora: ${formatDate(s.retornoPrevisto)}` : null
  }];
  if (teveSol) steps.push({
    k: "doc",
    titulo: "Documentos e informações adicionais",
    fonte: "Solicitações registradas pela Aon",
    feito: p.total === 0,
    quando: null,
    detalhe: p.total ? `${p.total} pendência(s) aguardando envio` : "Todas as solicitações foram atendidas"
  });
  steps.push({
    k: "cob",
    titulo: cob ? `Decisão de cobertura registrada: ${cob.situacao}` : "Decisão de cobertura registrada",
    fonte: "Informado pela seguradora, registrado pela Aon",
    feito: !!cob,
    quando: cob && cob.data
  });
  const indTitulo = cob && cob.situacao === "Cobertura recusada" ? "Indenização: não aplicável (cobertura não aceita)" : ind ? `Indenização: ${ind.status}` : "Indenização";
  steps.push({
    k: "ind",
    titulo: indTitulo,
    fonte: "Informado pela seguradora, registrado pela Aon",
    feito: !!ind && ["Indenização paga", "Não aplicável"].includes(ind.status) || !!cob && cob.situacao === "Cobertura recusada",
    quando: ind && ind.atualizadoEm
  });
  steps.push({
    k: "fim",
    titulo: "Acompanhamento concluído",
    fonte: "Registrado pela Aon",
    feito: !!s.encerrado,
    quando: s.encerrado && s.encerrado.ts
  });
  let achou = false;
  return steps.map(st => {
    if (st.feito) return {
      ...st,
      estado: "feito"
    };
    if (!achou) {
      achou = true;
      return {
        ...st,
        estado: "atual"
      };
    }
    return {
      ...st,
      estado: "pendente"
    };
  });
}
/* Casos que precisam de atenção da Aon (regras simples, derivadas dos registros). */
function motivosAtencao(s) {
  if (s.encerrado) return [];
  const m = [],
    p = pendencias(s),
    enc = s.encaminhamento || {};
  if (!s.organizadoEm) m.push("Nova comunicação ainda não organizada pela Aon");
  if ((s.solicitacoes || []).some(x => x.status === "Respondida")) m.push("Cliente respondeu a uma solicitação: revisar");
  if ((s.solicitacoes || []).some(x => x.status === "Aberta" && x.origem === "Seguradora")) m.push("Solicitação da seguradora em aberto");
  if (s.documentos.some(d => d.estado === "Recebido" && (d.arquivos || []).length > 0)) m.push("Documento enviado aguardando validação");
  if (enc.estado === "aberto" && !enc.protocolo) m.push("Abertura formal registrada, mas sem protocolo");
  if (enc.estado === "enviado" && daysSinceTs(enc.dataEnvio) >= 3) m.push(`Sem confirmação de recebimento há ${daysSinceTs(enc.dataEnvio)} dias`);
  const ms = s.mensagens || [];
  if (ms.length && ms[ms.length - 1].de === "Cliente") m.push("Cliente enviou uma mensagem: responder");
  const atr = (s.tarefas || []).filter(tarefaAtrasada).length;
  if (atr) m.push(`${atr} ação(ões) do plano atrasada(s)`);
  if ((s.solicitacoes || []).some(solAtrasada)) m.push("Solicitação ao cliente com prazo vencido");
  if (s.organizadoEm && p.total === 0 && daysSinceTs(s.atualizadoEm) >= 7) m.push(`Sem atualização há ${daysSinceTs(s.atualizadoEm)} dias`);
  return m;
}
function checklistEnc(s) {
  const pend = pendencias(s);
  return [{
    ok: !!s.segurado,
    texto: "Empresa segurada identificada"
  }, {
    ok: !!s.triagem,
    texto: s.triagem ? "Triagem confirmada pela Aon" : "Triagem ainda não confirmada pela Aon"
  }, {
    ok: !!s.apolice,
    texto: s.apolice ? `Apólice informada (${s.apolice})` : "Número da apólice não informado"
  }, {
    ok: !!s.dataOcorrencia,
    texto: s.dataOcorrencia ? "Data da ocorrência informada" : "Data da ocorrência desconhecida"
  }, {
    ok: (s.descricao || "").trim().length >= 10,
    texto: "Descrição do ocorrido registrada"
  }, {
    ok: !!(s.contato && (s.contato.email || s.contato.telefone)),
    texto: "Contato do cliente disponível"
  }, {
    ok: pend.docs.length === 0,
    texto: pend.docs.length ? `Documentos pendentes: ${pend.docs.map(d => d.nome).join("; ")}` : "Sem documentos pendentes"
  }, {
    ok: pend.sols.length === 0,
    texto: "Sem solicitações em aberto"
  }];
}
function gerarMensagemEnc(s, nomeAon) {
  const docs = s.documentos,
    rec = docs.filter(d => d.estado === "Recebido" || d.estado === "Validado"),
    pend = docs.filter(d => d.estado === "Pendente" || d.estado === "Substituir");
  const imp = [s.exposicaoDados && "possível exposição de dados", s.indisponibilidade && "indisponibilidade operacional"].filter(Boolean).join("; ");
  return ["Prezados,", "", `A Aon, corretora do segurado ${s.segurado}, encaminha a comunicação de incidente Cyber abaixo, para as providências cabíveis conforme o procedimento da seguradora e as condições da apólice${s.apolice ? ` ${s.apolice}` : ""}.`, "", `ID Atlas ${s.id} (identificador interno do Atlas, não é protocolo de seguradora)`, `Empresa segurada: ${s.segurado}`, `Apólice: ${s.apolice || "não informada"}`, `Tipo de incidente: ${s.tipo}`, `Ocorrência: ${s.dataOcorrencia ? formatDate(s.dataOcorrencia) : "data desconhecida"} · Comunicada ao Atlas em: ${formatDate(s.dataComunicacao)}`, `Descrição informada: ${s.descricao}`, s.triagem ? `Classificação preliminar da Aon (apoio automatizado, sujeita a revisão): ${s.triagem.categoria}, severidade ${s.triagem.severidade}, prioridade ${s.triagem.prioridade}` : "Classificação preliminar: ainda não confirmada", `Sistemas afetados: ${s.sistemas || "não informado"}`, `Impactos: ${[imp, s.impactos].filter(Boolean).join(" · ") || "não informados"}`, `Documentos recebidos (${rec.length}): ${rec.map(d => d.nome).join("; ") || "nenhum"}`, `Documentos pendentes (${pend.length}): ${pend.map(d => d.nome).join("; ") || "nenhum"}`, "", "Solicitamos a confirmação de recebimento e, quando houver a abertura formal, o número do protocolo.", "", "Atenciosamente,", `${nomeAon} · Aon (ambiente de demonstração)`].join("\n");
}

/* ------------------------------ triagem automatizada por regras locais (sem IA externa) ------------------------------ */
const PALAVRAS = [["Ransomware", /ransom|resgate|criptograf|sequestr/i], ["Vazamento de dados", /vazament|exposi[çc][ãa]o de dados|dados de clientes|dados pessoais/i], ["Acesso não autorizado", /acesso n[ãa]o autorizado|invas|intrus/i], ["Comprometimento de credenciais", /credenciais|phishing|senha/i], ["Fraude digital", /fraude|golpe|transfer[êe]ncia fraudulenta|engenharia social/i], ["Indisponibilidade de sistema", /indisponib|fora do ar|ddos|nega[çc][ãa]o de servi[çc]o/i]];
const CRITICOS = /erp|pagamento|prontu[áa]rio|faturamento|banking|conta corporativa|base de clientes/i;
const PERFIL_BASE = {
  "Ransomware": 3,
  "Vazamento de dados": 3,
  "Acesso não autorizado": 2,
  "Comprometimento de credenciais": 2,
  "Fraude digital": 2,
  "Indisponibilidade de sistema": 2,
  "Outro": 1
};
const EXPOSICOES = {
  "Ransomware": ["Extorsão cibernética", "Interrupção de negócios", "Restauração de dados", "Resposta a incidentes"],
  "Vazamento de dados": ["Responsabilidade por privacidade", "Notificação a titulares e autoridades", "Gerenciamento de crise", "Resposta a incidentes"],
  "Acesso não autorizado": ["Resposta a incidentes", "Responsabilidade por privacidade"],
  "Comprometimento de credenciais": ["Resposta a incidentes"],
  "Fraude digital": ["Fraude e perdas financeiras"],
  "Indisponibilidade de sistema": ["Interrupção de negócios", "Resposta a incidentes"],
  "Outro": ["Resposta a incidentes"]
};
const DOCS_POR_TIPO = {
  "Ransomware": [0, 1, 2, 3, 4],
  "Vazamento de dados": [1, 2, 3, 4],
  "Acesso não autorizado": [1, 2, 3],
  "Comprometimento de credenciais": [1, 3],
  "Fraude digital": [0, 3, 4],
  "Indisponibilidade de sistema": [1, 3, 4],
  "Outro": [3]
};
const PASSOS_EXTRA = {
  "Vazamento de dados": [{
    titulo: "Orientar o cliente a avaliar, com o controlador, a comunicação à ANPD e aos titulares (decisão do cliente)",
    etapa: "Tratamento"
  }],
  "Fraude digital": [{
    titulo: "Orientar o cliente a acionar o banco e preservar os comprovantes",
    etapa: "Evidências"
  }],
  "Ransomware": [{
    titulo: "Confirmar com o cliente a preservação de evidências antes da restauração",
    etapa: "Evidências"
  }]
};
const normDoc = n => norm(String(n).split(" (")[0]);
function analisar(s, todos) {
  const texto = `${s.descricao} ${s.sistemas} ${s.impactos}`;
  const sugerida = (PALAVRAS.find(([, re]) => re.test(texto)) || [])[0] || null;
  const categoria = s.tipo !== "Outro" ? s.tipo : sugerida || "Outro";
  let pts = PERFIL_BASE[categoria] || 1;
  const fatores = [{
    texto: `Categoria ${categoria}`,
    pontos: pts
  }];
  const add = (c, t, p) => {
    if (c) {
      fatores.push({
        texto: t,
        pontos: p
      });
      pts += p;
    }
  };
  const pe = s.pessoasAfetadas,
    v = s.valorEstimado || 0;
  add(s.exposicaoDados, "Possível exposição de dados informada", 2);
  add(pe >= 1000, `${pe} pessoas afetadas (1.000 ou mais)`, 2);
  add(pe >= 100 && pe < 1000, `${pe} pessoas afetadas (100 a 999)`, 1);
  add(s.indisponibilidade, "Indisponibilidade operacional informada", 1);
  add(CRITICOS.test(s.sistemas || ""), "Sistema crítico afetado (ex: ERP, pagamentos, prontuários)", 1);
  add(v >= 500000, `Valor estimado alto (${fmtBRL(v)})`, 2);
  add(v >= 100000 && v < 500000, `Valor estimado relevante (${fmtBRL(v)})`, 1);
  const recorr = (todos || []).filter(x => x.id !== s.id && norm(x.segurado) === norm(s.segurado) && x.tipo === s.tipo).length;
  add(recorr > 0, "Recorrência: já há caso do mesmo tipo para esta empresa", 1);
  let severidade = pts >= 7 ? "Crítica" : pts >= 5 ? "Alta" : pts >= 3 ? "Média" : "Baixa";
  let prioridade = severidade;
  if (s.exposicaoDados && s.indisponibilidade && PRIORIDADES.indexOf(prioridade) < 2) prioridade = "Alta";
  const lacunas = [];
  if (!s.dataOcorrencia) lacunas.push("Data da ocorrência não informada (a vigência da apólice não pode ser verificada)");
  if (s.pessoasAfetadas === null || s.pessoasAfetadas === undefined) lacunas.push("Quantidade de pessoas afetadas desconhecida");
  if (s.valorEstimado === null || s.valorEstimado === undefined) lacunas.push("Valor estimado do prejuízo desconhecido");
  if (!s.apolice) lacunas.push("Apólice não informada");
  if (!s.sistemas) lacunas.push("Sistemas afetados não informados");
  if (!s.medidas) lacunas.push("Medidas emergenciais não informadas");
  const docsNec = (DOCS_POR_TIPO[categoria] || DOCS_POR_TIPO["Outro"]).map(i => DOCS_SUGERIDOS[i]).map(nome => {
    const d = s.documentos.find(x => normDoc(x.nome) === normDoc(nome));
    return {
      nome,
      estado: d ? d.estado : null
    };
  });
  const base = [{
    titulo: "Confirmar apólice e vigência",
    etapa: "Triagem"
  }, {
    titulo: "Solicitar ao cliente os documentos que ainda faltam",
    etapa: "Evidências"
  }, {
    titulo: "Preparar o encaminhamento à seguradora",
    etapa: "Análise"
  }, {
    titulo: "Registrar protocolo e retornos da seguradora",
    etapa: "Retorno"
  }];
  return {
    categoria,
    sugerida,
    divergencia: sugerida && s.tipo !== "Outro" && sugerida !== s.tipo ? `O relato sugere "${sugerida}", mas foi informado "${s.tipo}": confirmar com o cliente.` : "",
    pontos: pts,
    severidade,
    risco: pts >= 6 ? "Alto" : pts >= 4 ? "Médio" : "Baixo",
    prioridade,
    fatores,
    lacunas,
    docsNec,
    impactos: [s.exposicaoDados && "Possível exposição de dados pessoais", s.indisponibilidade && "Indisponibilidade de sistemas ou da operação", v > 0 && `Prejuízo estimado de ${fmtBRL(v)}`, pe > 0 && `${pe} pessoa(s) possivelmente afetada(s)`].filter(Boolean),
    proximos: [...base, ...(PASSOS_EXTRA[categoria] || [])]
  };
}
function triagemEfetiva(s, todos) {
  const a = analisar(s, todos);
  return s.triagem ? {
    categoria: s.triagem.categoria,
    severidade: s.triagem.severidade,
    prioridade: s.triagem.prioridade,
    confirmada: true,
    ajustado: !!s.triagem.ajustado
  } : {
    categoria: a.categoria,
    severidade: a.severidade,
    prioridade: a.prioridade,
    confirmada: false
  };
}
const PRIOR_TONE = {
  Crítica: "red",
  Alta: "orange",
  Média: "amber",
  Baixa: "gray"
};
function sinalizarCobertura(s, apolices) {
  // Conferência de dados (vigência e itens cadastrados). Não indica se haverá cobertura.
  const ap = s.apolice ? (apolices || []).find(a => norm(a.numero) === norm(s.apolice)) : null;
  const expo = EXPOSICOES[s.tipo] || EXPOSICOES["Outro"];
  const r = (rotulo, tone, motivos) => ({
    rotulo,
    tone,
    motivos,
    apolice: ap,
    exposicoes: ap ? expo.map(e => ({
      nome: e,
      encontrada: ap.itens.includes(e)
    })) : expo.map(e => ({
      nome: e,
      encontrada: null
    }))
  });
  if (!s.apolice) return r("Dados insuficientes", "gray", ["Apólice não informada no aviso."]);
  if (!ap) return r("Dados insuficientes", "gray", [`A apólice ${s.apolice} não está cadastrada no Atlas.`]);
  const falt = expo.filter(e => !ap.itens.includes(e));
  if (!s.dataOcorrencia) return r("Dados insuficientes", "gray", ["Data da ocorrência desconhecida: não é possível conferir a vigência."]);
  if (s.dataOcorrencia < ap.vigenciaIni || s.dataOcorrencia > ap.vigenciaFim) return r("Divergência a verificar", "orange", [`A ocorrência (${formatDate(s.dataOcorrencia)}) está fora da vigência cadastrada (${formatDate(ap.vigenciaIni)} a ${formatDate(ap.vigenciaFim)}). Conferir com a apólice contratada.`]);
  if ((ap.exclui || []).includes(s.tipo)) return r("Divergência a verificar", "orange", [`O tipo "${s.tipo}" consta como exclusão no cadastro da apólice. Conferir com a apólice contratada.`]);
  if (falt.length === expo.length) return r("Divergência a verificar", "orange", ["Nenhum dos itens esperados para este tipo consta no cadastro da apólice. Conferir com a apólice contratada."]);
  const m = [];
  if (falt.length) m.push(`Itens sem correspondência no cadastro da apólice: ${falt.join("; ")}.`);
  if (norm(ap.segurado) !== norm(s.segurado)) m.push(`A apólice está cadastrada em nome de outra empresa (${ap.segurado}).`);
  if ((s.valorEstimado || 0) > ap.limite) m.push(`O valor estimado (${fmtBRL(s.valorEstimado)}) é maior que o limite cadastrado (${fmtBRL(ap.limite)}).`);
  if (pendencias(s).docs.length) m.push("Há documentos pendentes; esta conferência pode mudar quando forem recebidos.");
  return m.length ? r("Pontos a conferir", "amber", m) : r("Itens conferem", "blue", ["A ocorrência está dentro da vigência cadastrada e os itens esperados constam no cadastro da apólice."]);
}
function estadoCiclo(s) {
  const enc = encIdx(s),
    p = pendencias(s);
  if (s.encerrado) return "Resolvido";
  if (enc >= 4 && s.cobertura) return "Em tratamento";
  if (enc >= 4) return p.docs.length ? "Aguardando documentação" : "Em avaliação de cobertura";
  if (p.docs.length) return "Aguardando documentação";
  if (p.sols.length || s.status === "Aguardando informações do cliente") return "Aguardando informações";
  return s.organizadoEm ? "Em análise" : "Recebido";
}
function proximaAcao(s, paraCliente) {
  const enc = s.encaminhamento || {},
    idx = encIdx(s),
    p = pendencias(s),
    quem = paraCliente ? "Você" : "Cliente";
  if (s.encerrado) return "Nenhuma ação pendente: o acompanhamento foi concluído.";
  if (p.total) return `${quem}: enviar ${[...p.docs.map(d => d.nome), ...p.sols.map(x => `resposta a "${x.texto}"`)].join("; ")}.`;
  if (!s.organizadoEm) return "Aon: organizar o caso e confirmar a triagem.";
  if (idx < 2) return "Aon: concluir a organização e encaminhar a comunicação à seguradora.";
  if (idx === 2) return "Aguardar a confirmação de recebimento pela seguradora (a Aon registra quando for informada).";
  if (idx === 3) return "Aguardar a abertura formal do sinistro e o protocolo da seguradora.";
  if (!enc.protocolo) return "Aguardar o protocolo da seguradora (a Aon registra quando for informado).";
  const cob = visivel(s.cobertura, paraCliente) ? s.cobertura : null,
    ind = visivel(s.indenizacao, paraCliente) ? s.indenizacao : null;
  if (!cob) return "Aguardar a análise e a decisão de cobertura da seguradora.";
  if (cob.situacao === "Cobertura recusada") return paraCliente ? "A seguradora informou cobertura não aceita. Converse com a Aon sobre os próximos passos." : "Orientar o cliente sobre os próximos passos após a decisão da seguradora e encerrar quando apropriado.";
  if (ind && ind.status === "Indenização paga") return paraCliente ? "Aguardar o encerramento do acompanhamento pela Aon." : "Confirmar o pagamento com o cliente e encerrar o acompanhamento.";
  return "Aguardar a atualização do pagamento informada pela seguradora.";
}
const hojeIsoStr = () => isoFromDate(new Date());
const tarefaAtrasada = t => t.status === "Aberta" && !!t.prazo && t.prazo < hojeIsoStr();
const solAtrasada = x => x.status === "Aberta" && !!x.prazo && x.prazo < hojeIsoStr();
function migrar(s) {
  return {
    pessoasAfetadas: null,
    valorEstimado: null,
    medidas: "",
    dataIdentificacao: "",
    naoSei: {},
    triagem: null,
    tarefas: [],
    solicitacoes: [],
    complementos: [],
    mensagens: [],
    retornos: [],
    retornoPrevisto: "",
    ...s
  };
}

/* ------------------------------ apoio didático: guia do caso, explicações e dossiê ------------------------------ */
function guiaCaso(s) {
  const idx = encIdx(s),
    p = pendencias(s);
  const etapas = [{
    k: "reg",
    titulo: "Recebido",
    tab: "resumo",
    feito: true
  }, {
    k: "tri",
    titulo: "Triagem",
    tab: "analise",
    feito: !!s.triagem
  }, {
    k: "pen",
    titulo: "Documentos e pendências",
    tab: "docs",
    feito: !!s.organizadoEm && p.total === 0
  }, {
    k: "env",
    titulo: "Encaminhamento à seguradora",
    tab: "seg",
    feito: idx >= 2
  }, {
    k: "ret",
    titulo: "Retorno da seguradora",
    tab: "seg",
    feito: !!s.cobertura
  }, {
    k: "fim",
    titulo: "Conclusão",
    tab: "resumo",
    feito: !!s.encerrado
  }];
  let achou = false;
  return etapas.map(e => e.feito ? {
    ...e,
    estado: "feito"
  } : !achou ? (achou = true, {
    ...e,
    estado: "atual"
  }) : {
    ...e,
    estado: "pendente"
  });
}
function explicaStatus(label) {
  const L = String(label);
  if (L === "Comunicação registrada") return "Recebemos a sua comunicação no Atlas. A Aon ainda vai organizar o caso e conferir as informações.";
  if (L === "Em organização pela Aon") return "A Aon está conferindo as informações e os documentos e se prepara para encaminhar o caso à seguradora.";
  if (L === "Aguardando informações do cliente" || L === "Aguardando documentos adicionais") return "A Aon precisa de algo seu para o caso andar. Veja as pendências abaixo e responda ou anexe o que foi pedido.";
  if (L === "Encaminhada à seguradora") return "A Aon já enviou a comunicação para a seguradora. Agora falta a seguradora confirmar que recebeu.";
  if (L === "Recebimento confirmado pela seguradora") return "A seguradora confirmou que recebeu a comunicação. Falta ela abrir o sinistro formalmente e informar o protocolo.";
  if (L === "Sinistro formalmente aberto pela seguradora") return "A seguradora abriu o sinistro e informou um protocolo (veja acima). Agora ela vai analisar o caso.";
  if (L === "Em análise pela seguradora") return "A seguradora está analisando o caso. Só ela decide sobre cobertura e indenização; a Aon registra aqui o que ela informar.";
  if (L.startsWith("Cobertura aceita") || L.startsWith("Cobertura parcial")) return "A seguradora informou a sua decisão sobre a cobertura. Os próximos passos, como o pagamento, são dela; a Aon registra aqui quando houver novidade.";
  if (L.startsWith("Cobertura não aceita")) return "A seguradora informou que não aceitou a cobertura. Converse com a Aon para entender os próximos passos.";
  if (L.startsWith("Indenização")) return "A seguradora informou sobre o pagamento. Os valores e datas aparecem abaixo, exatamente como ela comunicou à Aon.";
  if (L === "Acompanhamento concluído") return "A Aon concluiu o acompanhamento deste caso. O histórico continua disponível para consulta.";
  return "";
}
const esc = x => String(x == null ? "" : x).replace(/[&<>"']/g, c => ({
  "&": "&amp;",
  "<": "&lt;",
  ">": "&gt;",
  '"': "&quot;",
  "'": "&#39;"
})[c]);
function baixarArquivoTexto(nome, conteudo, mime) {
  try {
    const url = URL.createObjectURL(new Blob([conteudo], {
      type: mime
    }));
    const a = document.createElement("a");
    a.href = url;
    a.download = nome;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 30000);
    return true;
  } catch (e) {
    return false;
  }
}
function gerarDossieHtml(s, todos, nomeAon) {
  const a = analisar(s, todos),
    tri = triagemEfetiva(s, todos),
    p = pendencias(s),
    enc = s.encaminhamento || {};
  const lin = (k, v) => `<tr><th>${esc(k)}</th><td>${esc(v || "—")}</td></tr>`;
  const hist = [...s.historico].filter(h => !h.interno).sort((x, y) => String(x.ts).localeCompare(String(y.ts)));
  return `<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><title>Dossiê ${esc(s.id)}</title><style>body{font-family:Arial,sans-serif;max-width:820px;margin:24px auto;padding:0 16px;color:#111;line-height:1.4}h1{font-size:20px}h2{font-size:15px;border-bottom:1px solid #ccc;padding-bottom:4px;margin-top:22px}table{border-collapse:collapse;width:100%;font-size:14px}th{text-align:left;width:200px;vertical-align:top;color:#555;font-weight:normal;padding:3px 8px 3px 0}td{padding:3px 0}.aviso{background:#fff7e0;border:1px solid #e6c15a;padding:8px 10px;font-size:13px}li{font-size:14px}</style></head><body>
<h1>Dossiê de comunicação de incidente Cyber</h1>
<p>Preparado pela Aon (ambiente de demonstração) em ${esc(fmtTs(nowTs()))}${nomeAon ? ` por ${esc(nomeAon)}` : ""}.</p>
<div class="aviso">O identificador ${esc(s.id)} é interno do Atlas e não é protocolo de seguradora. Este dossiê apenas organiza as informações recebidas; não indica decisão de cobertura nem de indenização. A classificação é preliminar e sujeita à revisão humana.</div>
<h2>Empresa e apólice</h2><table>${lin("Empresa segurada", s.segurado)}${lin("Apólice", s.apolice || "não informada")}${lin("Contato", `${s.contato.nome}${s.contato.email ? ` · ${s.contato.email}` : ""}${s.contato.telefone ? ` · ${s.contato.telefone}` : ""}`)}</table>
<h2>Ocorrência</h2><table>${lin("Tipo de incidente", s.tipo)}${lin("Data da ocorrência", s.dataOcorrencia ? formatDate(s.dataOcorrencia) : "não informada")}${lin("Percebido em", s.dataIdentificacao ? formatDate(s.dataIdentificacao) : "não informado")}${lin("Comunicação ao Atlas", formatDate(s.dataComunicacao))}${lin("Descrição", s.descricao)}${lin("Sistemas afetados", s.sistemas || "não informados")}${lin("Impactos", a.impactos.join("; ") || "não informados")}${lin("Medidas adotadas", s.medidas || "não informadas")}</table>
<h2>Classificação preliminar</h2><table>${lin("Categoria", tri.categoria)}${lin("Severidade", tri.severidade)}${lin("Prioridade", tri.prioridade)}${lin("Situação", tri.confirmada ? "Confirmada pela Aon" : "Sugestão automatizada (regras locais), ainda não confirmada")}</table>
${a.lacunas.length ? `<p><strong>Informações ainda desconhecidas:</strong></p><ul>${a.lacunas.map(x => `<li>${esc(x)}</li>`).join("")}</ul>` : ""}
<h2>Documentos</h2>${s.documentos.length ? `<ul>${s.documentos.map(d => `<li>${esc(d.nome)}: ${esc(d.estado)}${(d.arquivos || []).filter(f => !f.substituido).length ? ` (${esc((d.arquivos || []).filter(f => !f.substituido).map(f => f.nome).join(", "))})` : ""}</li>`).join("")}</ul>` : "<p>Nenhum documento registrado.</p>"}
<p><strong>Pendências em aberto:</strong> ${p.total ? esc([...p.docs.map(d => d.nome), ...p.sols.map(x => x.texto)].join("; ")) : "nenhuma"}.</p>
<h2>Encaminhamento</h2><table>${lin("Situação", {
    nenhum: "ainda não encaminhado",
    preparado: "mensagem preparada, ainda não enviada",
    enviado: "enviado pela Aon",
    recebido: "recebimento confirmado pela seguradora",
    aberto: "sinistro aberto pela seguradora"
  }[enc.estado || "nenhum"])}${lin("Protocolo da seguradora", enc.protocolo || "ainda não informado")}</table>
<h2>Histórico do caso</h2><ul>${hist.map(h => `<li>${esc(fmtTs(h.ts))}: ${esc(h.texto)}</li>`).join("")}</ul>
</body></html>`;
}
function copiarTexto(txt) {
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(txt);
      return true;
    }
  } catch (e) {/* tenta o método antigo */}
  try {
    const ta = document.createElement("textarea");
    ta.value = txt;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand("copy");
    document.body.removeChild(ta);
    return ok;
  } catch (e) {
    return false;
  }
}
const nextSinistroId = list => {
  const nums = list.map(i => parseInt(String(i.id).split("-").pop(), 10)).filter(n => !isNaN(n));
  return `SIN-${new Date().getFullYear()}-${String((nums.length ? Math.max(...nums) : 0) + 1).padStart(3, "0")}`;
};

/* ------------------------------ persistência local (localStorage + IndexedDB) ------------------------------ */
function storeLoad() {
  try {
    const ok = l => Array.isArray(l) && l.every(x => x && x.id && Array.isArray(x.documentos) && Array.isArray(x.historico));
    const raw = window.localStorage.getItem(STORE_KEY);
    if (raw) {
      const o = JSON.parse(raw);
      if (o && o.v === 5 && ok(o.sinistros)) return {
        sinistros: o.sinistros.map(migrar),
        apolices: Array.isArray(o.apolices) ? o.apolices : seedApolices()
      };
      return null;
    }
    const raw4 = window.localStorage.getItem(STORE_KEY_V4); // migra a versão anterior do protótipo, se existir
    if (raw4) {
      const o = JSON.parse(raw4);
      if (o && o.v === 4 && ok(o.sinistros)) return {
        sinistros: o.sinistros.map(migrar),
        apolices: seedApolices()
      };
    }
    return null;
  } catch (e) {
    return null;
  }
}
const storeStr = (sinistros, apolices) => JSON.stringify({
  v: 5,
  sinistros,
  apolices
});
function storeSaveRaw(str) {
  try {
    window.localStorage.setItem(STORE_KEY, str);
    return true;
  } catch (e) {
    return false;
  }
}
function sessaoLoad() {
  try {
    const r = window.sessionStorage.getItem(SESSAO_KEY);
    const o = r ? JSON.parse(r) : null;
    return o && (o.perfil === "cliente" || o.perfil === "aon") ? o : null;
  } catch (e) {
    return null;
  }
}
function sessaoSave(o) {
  try {
    if (o) window.sessionStorage.setItem(SESSAO_KEY, JSON.stringify(o));else window.sessionStorage.removeItem(SESSAO_KEY);
  } catch (e) {/* ignora */}
}
function idbOpen() {
  return new Promise((res, rej) => {
    try {
      const r = window.indexedDB.open("atlas-seguros-arquivos", 1);
      r.onupgradeneeded = () => r.result.createObjectStore("arquivos");
      r.onsuccess = () => res(r.result);
      r.onerror = () => rej(r.error);
    } catch (e) {
      rej(e);
    }
  });
}
async function arquivoPut(id, blob) {
  const db = await idbOpen();
  return new Promise((res, rej) => {
    const tx = db.transaction("arquivos", "readwrite");
    tx.objectStore("arquivos").put(blob, id);
    tx.oncomplete = () => res(true);
    tx.onerror = () => rej(tx.error);
  });
}
async function arquivoGet(id) {
  const db = await idbOpen();
  return new Promise((res, rej) => {
    const rq = db.transaction("arquivos", "readonly").objectStore("arquivos").get(id);
    rq.onsuccess = () => res(rq.result || null);
    rq.onerror = () => rej(rq.error);
  });
}
async function arquivoDel(id) {
  try {
    const db = await idbOpen();
    return new Promise(res => {
      const tx = db.transaction("arquivos", "readwrite");
      tx.objectStore("arquivos").delete(id);
      tx.oncomplete = () => res(true);
      tx.onerror = () => res(false);
    });
  } catch (e) {
    return false;
  }
}
async function arquivosLimpar() {
  try {
    const db = await idbOpen();
    return new Promise(res => {
      const tx = db.transaction("arquivos", "readwrite");
      tx.objectStore("arquivos").clear();
      tx.oncomplete = () => res(true);
      tx.onerror = () => res(false);
    });
  } catch (e) {
    return false;
  }
}
// arr: [{ file, tipo }] -> { metas, erros }
async function guardarArquivos(arr, por) {
  const metas = [],
    erros = [];
  for (const {
    file,
    tipo
  } of arr) {
    if (file.size > MAX_ARQUIVO_MB * 1048576) {
      erros.push(`${file.name}: maior que ${MAX_ARQUIVO_MB} MB (limite deste protótipo).`);
      continue;
    }
    const id = uid("ARQ");
    let guardado = true;
    try {
      await arquivoPut(id, file);
    } catch (e) {
      guardado = false;
      erros.push(`${file.name}: não foi possível guardar o conteúdo neste navegador; só o nome foi registrado.`);
    }
    metas.push({
      id,
      nome: file.name,
      formato: (file.name.split(".").length > 1 && file.name.split(".").pop() || file.type || "arquivo").toLowerCase(),
      tipoDoc: tipo,
      tamanho: file.size,
      anexadoEm: nowTs(),
      anexadoPor: por,
      guardado
    });
  }
  return {
    metas,
    erros
  };
}
async function abrirArquivo(meta, baixar) {
  try {
    const blob = meta.id ? await arquivoGet(meta.id) : null;
    if (!blob) return "O conteúdo deste arquivo não está disponível neste navegador (só o nome foi registrado).";
    const url = URL.createObjectURL(blob);
    if (baixar) {
      const a = document.createElement("a");
      a.href = url;
      a.download = meta.nome;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    } else window.open(url, "_blank");
    setTimeout(() => URL.revokeObjectURL(url), 60000);
    return "";
  } catch (e) {
    return "Não foi possível abrir o arquivo.";
  }
}

